{
 "id": "one-light",
 "family": "one",
 "label": "One Light",
 "dark": false,
 "source": "https://github.com/atom/atom/blob/2c902d501e/packages/one-light-syntax/styles/colors.less (hsl, 2018-2021 values); hex from https://github.com/rakr/vim-one/blob/master/colors/one.vim (light block); mono-1 hex from https://github.com/navarasu/onedark.nvim/blob/master/lua/onedark/palette.lua (light.fg)",
 "colors": {
  "bg": [
   "#fafafa",
   "syntax-bg"
  ],
  "bg_alt": [
