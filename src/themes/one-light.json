  ],
  "line": [
   "#d0d0d0",
   "visual_grey (selection)"
  ],
  "comment": [
   "#a0a1a7",
   "mono-3"
  ],
  "fg_dim": [
   "#696c77",
   "mono-2"
  ],
  "fg": [
   "#383a42",
   "mono-1 (syntax-fg)"
  ],
  "red": [
   "#e45649",
   "hue-5 (red 1)"
  ],
  "orange": [
   "#986801",
   "hue-6 (orange 1)"
  ],
  "yellow": [
   "#c18401",
   "hue-6-2 (orange 2)"
  ],
  "green": [
   "#50a14f",
   "hue-4 (green)"
  ],
  "cyan": [
   "#0184bc",
   "hue-1 (cyan)"
  ],
  "blue": [
   "#4078f2",
   "hue-2 (blue)"
  ],
  "purple": [
   "#a626a4",
   "hue-3 (purple)"
  ]
 },
 "extra": {
  "hue-5-2 (red 2)": "#ca1243",
  "mono-4": "#c2c2c3",
  "syntax-gutter": "#9e9e9e",
  "syntax-accent": "#526fff",
  "syntax-accent-2": "#0083be",
  "vertsplit": "#e7e9e1",
  "special_grey": "#d3d3d3",
  "pmenu": "#dfdfdf"
 }
}